# MeshBridge — service systemd pour le Raspberry Pi.
# Installation :
#   sudo cp deploy/meshbridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now meshbridge
# Logs en direct :  journalctl -u meshbridge -f
#
# Chemins écrits pour l'utilisateur « antho », repo dans /home/antho/meshbridge —
# à adapter si l'installation change.

[Unit]
Description=MeshBridge — relai off-grid LoRa + IA
# Le Pi est en WiFi : on attend une connexion réseau effective (pas juste
# l'interface levée) et la pile Bluetooth avant de démarrer.
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
User=antho
WorkingDirectory=/home/antho/meshbridge
ExecStart=/home/antho/meshbridge/.venv/bin/python3 src/bridge.py
# Logs visibles immédiatement dans journalctl (pas de mise en tampon Python)
Environment=PYTHONUNBUFFERED=1
# Crash ou sortie inattendue → relance après 10 s, indéfiniment
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
