# MeshBridge — MODÈLE de service systemd pour le Raspberry Pi.
# Ne pas copier tel quel : les marqueurs __USER__ et __REPO__ sont remplis
# automatiquement par le script d'installation, qui détecte l'utilisateur
# courant et l'emplacement du repo :
#   python3 deploy/install.py
# Logs en direct :  journalctl -u meshbridge -f

[Unit]
Description=MeshBridge — relai off-grid LoRa + IA
# Le Pi est en WiFi : on attend une connexion réseau effective (pas juste
# l'interface levée) et la pile Bluetooth avant de démarrer.
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__
ExecStart=__REPO__/.venv/bin/python3 src/bridge.py
# Logs visibles immédiatement dans journalctl (pas de mise en tampon Python)
Environment=PYTHONUNBUFFERED=1
# Crash ou sortie inattendue → relance après 10 s, indéfiniment
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
