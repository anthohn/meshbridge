# ──────────────────────────────────────────────────────────────
# MODÈLE — copie ce fichier en ".env" (déjà ignoré par .gitignore)
# à la racine du repo, sur CHAQUE machine (PC de config ET Raspberry
# Pi), puis remplis tes vraies valeurs. Le fichier ".env" lui-même
# ne sera jamais poussé sur GitHub.
# ──────────────────────────────────────────────────────────────

# Clé du canal privé MeshBridge — utilisée par scripts/config_meshbridge.py (PC)
# Génère-la avec : python3 -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
MESHBRIDGE_PSK=colle-ta-cle-base64-ici

# Clé API Google Gemini — utilisée par src/bridge.py sur le Raspberry Pi
# Optionnelle : sans elle, le système bascule directement sur Ollama (local).
GEMINI_API_KEY=colle-ta-cle-gemini-ici

# Adresse BLE d'Aurora — utilisée par src/bridge.py sur le Raspberry Pi
# (MAC notée lors de l'appairage bluetoothctl, voir README étape 2)
AURORA_BLE_MAC=AA:BB:CC:DD:EE:FF

# PIN Bluetooth à 6 chiffres — utilisé par scripts/config_meshbridge.py (PC)
# pour activer le BLE sur Aurora (option 4 du menu)
AURORA_BLE_PIN=123456
